<nav class="navbar has-shadow is-hidden-mobile" data-controller="navbar">
  <div class="navbar-brand">
    <%= link_to "AlterTrack", root_path, class: "navbar-item is-size-4" %>

    <a class="navbar-burger" data-navbar-target="burger" data-action="navbar#toggle">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </a>
  </div>

  <div class="navbar-menu" data-navbar-target="menu">
    <div class="navbar-start">
      <%= link_to "Links", links_path, class: "navbar-item is-normal #{"is-selected has-text-white" if request.path == links_path || request.path == root_path}" %>
      <div class="navbar-item has-dropdown is-hoverable is-boxed">
        <%= tag.a "Books", class: "navbar-link is-arrowless is-boxed #{"is-selected has-text-white" if request.path == books_path}" %>
        <div class="navbar-dropdown">
          <% Book.categories.each_key do |category| %>
            <%= link_to category.capitalize, books_path(category: category), class: "navbar-item #{"is-selected has-text-white" if @category == category}" %>
          <% end %>
        </div>
      </div>
      <div class="navbar-item has-dropdown is-hoverable is-boxed">
        <%= tag.a "Films", class: "navbar-link is-arrowless is-boxed #{"is-selected has-text-white" if request.path == films_path}" %>
        <div class="navbar-dropdown">
          <% Film.categories.each_key do |category| %>
            <%= link_to category.capitalize, films_path(category: category), class: "navbar-item #{"is-selected has-text-white" if @category == category}" %>
          <% end %>
        </div>
      </div>
      <%= link_to "Finance", finance_path, class: "navbar-item is-normal #{"is-selected has-text-white" if request.path == finance_path}" %>
    </div>

    <div class="navbar-end">
      <hr class="p-0 mt-1 m-0">
      <hr class="p-0 mb-1 m-0">
      <div class="navbar-item buttons p-0">
        <% if signed_in? %>
          <%= link_to "API", api_access_tokens_path, class: "navbar-item" %>
          <%= link_to "Account", edit_user_registration_path, class: "navbar-item" %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "button navbar-item my-2 ml-2 mr-3" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "button ml-2 my-2" %>
          <%= link_to "Sign up", new_user_registration_path, class: "button mr-3 my-2 is-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>

<% if signed_in? %>
  <nav class="navbar is-hidden-tablet is-fixed-bottom has-shadow">
    <div class="navbar-brand is-flex is-justify-content-space-around">
      <%= link_to "Links", links_path, class: "navbar-item #{"has-text-primary" if request.path == links_path || request.path == root_path}" %>

      <div class="navbar-item dropdown is-up <%= 'has-text-primary' if request.path == books_path %>" data-controller="dropdown">
        <%= tag.button "Books", class: "dropdown-trigger", data: {action: "dropdown#toggle"}%>
        <div class="dropdown-menu dropdown-content">
          <% Book.categories.each_key do |category| %>
            <%= link_to category.capitalize, books_path(category: category), class: "navbar-item #{"has-text-primary" if @category == category}" %>
          <% end %>
        </div>
      </div>

      <div class="navbar-item dropdown is-up <%= 'has-text-primary' if request.path == films_path %>" data-controller="dropdown">
        <%= tag.button "Films", class: "dropdown-trigger", data: {action: "dropdown#toggle"}%>
        <div class="dropdown-menu dropdown-content">
          <% Film.categories.each_key do |category| %>
            <%= link_to category.capitalize, films_path(category: category), class: "navbar-item #{"has-text-primary" if @category == category}" %>
          <% end %>
        </div>
      </div>

      <%= link_to "Finance", finance_path, class: "navbar-item #{"has-text-primary" if request.path == finance_path}" %>

      <div class="navbar-item dropdown is-right is-up" data-controller="dropdown">
        <%= tag.button "Settings", class: "dropdown-trigger", data: {action: "dropdown#toggle"}%>
        <div class="dropdown-menu dropdown-content">
          <%= link_to "API", api_access_tokens_path, class: "navbar-item" %>
          <%= link_to "Account", edit_user_registration_path, class: "navbar-item" %>
          <hr class="dropdown-divider">
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "navbar-item" %> 
        </div>
      </div>
    </div>
  </nav>
<% end %>
