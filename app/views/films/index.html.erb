<%= turbo_frame_tag "content", data: {turbo_action: :advance} do %>
  <div class="container p-4 my-4">
    <div class="is-flex is-justify-content-space-between">
      <%= tag.h1 @category.capitalize + " (#{@counts.values.sum})", class: "title is-3"%>
      <%= link_to "Add", new_film_path(category: @category, status: @status), class: "button my-auto" %>
    </div>
    <div class="tabs is-centered is-boxed">
      <ul>
        <% Film.statuses.each_key do |status| %>
          <li class="<%="is-active" if status == @status %>">
            <%= link_to status.capitalize + " (#{@counts["#{status}"] || 0})", films_path(status: status, category: @category) %>
          </li>
        <% end %>
      </ul>
    </div>
    <div class="fixed-grid has-1-cols-mobile has-2-cols-tablet has-3-cols-desktop">
      <div class="grid">
        <% @films.each do |film| %>
          <%= render "card", film: film %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
